# ─── Server Configuration ────────────────────────────────────────────────────

# Port the Express server listens on (default: 3001)
PORT=3001

# JWT signing secret — REQUIRED in production, must be long and random.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# Node environment — set to "production" in production deployments
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production only).
# In development, all localhost ports are allowed automatically.
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────

# API base URL proxied by Vite dev server (matches server PORT above)
# VITE_API_URL=http://localhost:3001
