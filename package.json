{
  "name": "healthcare-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run mock:emit\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench",
    "test:e2e": "playwright test",
    "test:e2e:full": "RUN_LARGE_SCROLL_TEST=1 playwright test",
    "test:coverage": "vitest run --coverage",
    "mock:seed": "tsx server/src/scripts/seed.ts",
    "mock:emit": "tsx server/src/scripts/emit.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.28.0",
    "antd": "^5.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.22.3",
    "zustand": "^4.5.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.4.0",
    "axe-core": "^4.9.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^3.18.0",
    "jsdom": "^24.0.0",
    "msw": "^2.2.13",
    "prettier": "^3.2.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.6",
    "vite-plugin-checker": "^0.6.4",
    "vitest": "^1.4.0",
    "vitest-axe": "^0.1.0",
    "ws": "^8.16.0"
  }
}
